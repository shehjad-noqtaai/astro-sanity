# Real demo project (org: shehjad) — public identifiers, safe to commit.
PUBLIC_SANITY_PROJECT_ID=im07utyl
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Preview wiring: 'vanilla' (default — plain script, reload-driven updates)
# or 'svelte' (Svelte islands + @sanity/core-loader live queries: the home
# header updates as the editor types, no reload). Build-time flag.
# PUBLIC_VISUAL_EDITING_FLAVOR=svelte

# Viewer token — enables preview mode (drafts perspective + preview-url-secret
# validation). Without it the site still runs, published-only, and the
# Presentation tool cannot connect. Create at
# https://sanity.io/manage/project/im07utyl/api or ask Shehjad. NEVER commit it.
SANITY_API_READ_TOKEN=
