---
// Visual editing without React: enableVisualEditing() from
// @sanity/visual-editing is framework-agnostic. The script is injected per
// request — only for visitors whose preview cookie passed secret validation
// (see src/middleware.ts) — so end users never receive visual-editing code.
interface Props {
  title: string
}

const { title } = Astro.props
const preview = Astro.locals.preview
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    {
      preview && (
        <div class="preview-banner">
          Preview mode — you are seeing draft content.
          <a href="/api/preview/disable">Exit preview</a>
        </div>
      )
    }
    <header>
      <nav><a href="/">← All posts</a></nav>
    </header>
    <slot />
    {
      preview && (
        <script>
          import { enableVisualEditing } from '@sanity/visual-editing'
          enableVisualEditing({
            // Presentation drives refreshes via postMessage when it can; this
            // fallback hard-reloads for manual browser visits in preview mode.
            refresh: (payload) => {
              if (payload.source === 'mutation') {
                return new Promise((resolve) => {
                  window.location.reload()
                  resolve()
                })
              }
              return false
            },
          })
        </script>
      )
    }
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --ink: #1a1a1a;
    --muted: #6b6b6b;
    --accent: #f03e2f;
    --rule: #e8e4de;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0 auto;
    max-width: 42rem;
    padding: 2rem 1.25rem 6rem;
    font-family: Georgia, 'Times New Roman', serif;
    line-height: 1.6;
    color: var(--ink);
    background: #faf8f5;
  }
  .preview-banner {
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
    background: #fff3cd;
    border: 1px solid #e6d9a8;
    border-radius: 4px;
    padding: 0.5rem 0.75rem;
    margin-bottom: 1.5rem;
  }
  .preview-banner a {
    margin-left: 0.5rem;
    font-weight: 600;
  }
  header nav {
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
    margin-bottom: 3rem;
  }
  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  h1 {
    font-size: 2.4rem;
    line-height: 1.15;
    margin: 0 0 0.5rem;
  }
  h2 {
    margin-top: 2.5rem;
  }
  .muted {
    color: var(--muted);
    font-family: system-ui, sans-serif;
    font-size: 0.9rem;
  }
  .post-list {
    list-style: none;
    padding: 0;
  }
  .post-list li {
    border-bottom: 1px solid var(--rule);
    padding: 1.5rem 0;
  }
  .post-list h2 {
    margin: 0 0 0.35rem;
    font-size: 1.4rem;
  }
  article img {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
  }
  blockquote {
    border-left: 3px solid var(--accent);
    margin-left: 0;
    padding-left: 1.25rem;
    color: var(--muted);
    font-style: italic;
  }
</style>
