---
// FIX 1: visual editing without React. @sanity/visual-editing ships a
// framework-agnostic enableVisualEditing() — the React <VisualEditing/>
// component in @sanity/astro is just a thin wrapper around it. The script
// below is only injected when the preview flag is on, so published pages
// carry no visual-editing code at all.
interface Props {
  title: string
}

const { title } = Astro.props
const visualEditingEnabled =
  import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === 'true'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    {
      visualEditingEnabled && (
        <script>
          import { enableVisualEditing } from '@sanity/visual-editing'
          enableVisualEditing()
        </script>
      )
    }
  </body>
</html>
