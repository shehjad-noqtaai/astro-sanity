---
// PROBLEM 1: <VisualEditing/> from @sanity/astro is a React component under
// the hood. Rendering it requires @astrojs/react + react + react-dom in a
// codebase that otherwise ships zero React.
import { VisualEditing } from '@sanity/astro/visual-editing'

interface Props {
  title: string
}

const { title } = Astro.props
const visualEditingEnabled =
  import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === 'true'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <VisualEditing enabled={visualEditingEnabled} zIndex={1000} />
  </body>
</html>
