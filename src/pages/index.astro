---
import { loggedFetch } from '../lib/sanity'
import Layout from '../layouts/Layout.astro'

interface PostListItem {
  title: string
  slug: string
  excerpt?: string
  publishedAt?: string
}

interface Settings {
  title?: string
  description?: string
}

const { preview } = Astro.locals

const [settings, posts] = await Promise.all([
  loggedFetch<Settings | null>(
    `*[_type == "settings"][0]{title, description}`,
    {},
    preview
  ),
  loggedFetch<PostListItem[]>(
    `*[_type == "post" && defined(slug.current)] | order(publishedAt desc){
      title,
      "slug": slug.current,
      excerpt,
      publishedAt
    }`,
    {},
    preview
  ),
])

const siteTitle = settings?.title ?? 'Astro + Sanity preview demo'
---

<Layout title={siteTitle}>
  <main>
    <h1>{siteTitle}</h1>
    {settings?.description && <p class="muted">{settings.description}</p>}
    <ul class="post-list">
      {
        posts.map((post) => (
          <li>
            <h2>
              <a href={`/posts/${post.slug}`}>{post.title}</a>
            </h2>
            {post.excerpt && <p>{post.excerpt}</p>}
            {post.publishedAt && (
              <p class="muted">
                {new Date(post.publishedAt).toLocaleDateString('en-US', {
                  dateStyle: 'long',
                })}
              </p>
            )}
          </li>
        ))
      }
      {posts.length === 0 && <li>No posts yet — publish some in the Studio.</li>}
    </ul>
  </main>
</Layout>
