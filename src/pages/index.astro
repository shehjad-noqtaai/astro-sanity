---
// FIX 2 in practice: every fetch goes through the single wrapped client.
import { loggedFetch } from '../lib/sanity'
import Layout from '../layouts/Layout.astro'

interface Post {
  title: string
  slug: { current: string }
}

let posts: Post[] = []
let siteTitle = 'Astro + Sanity preview demo'

try {
  siteTitle =
    (await loggedFetch<string>(`*[_type == "settings"][0].title`)) ?? siteTitle
  posts = await loggedFetch<Post[]>(
    `*[_type == "post" && defined(slug.current)]{title, slug}`
  )
} catch {
  // demo project id — fine to render without content
}
---

<Layout title={siteTitle}>
  <main>
    <h1>{siteTitle}</h1>
    <ul>
      {posts.map((post) => <li>{post.title}</li>)}
      {posts.length === 0 && <li>No posts (set PUBLIC_SANITY_PROJECT_ID)</li>}
    </ul>
  </main>
</Layout>
